# Copy to .env and fill in your values. Never commit .env.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# Supabase -> Connect -> Transaction pooler (IPv4, port 6543). Do not use the
# Session pooler (5432): on the free plan it admits only 15 clients and the
# services plus the flow processes can exceed that (EMAXCONNSESSION).
# URL-encode special characters in the password ($ -> %24, @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Redis password for sessions / rate limits (internal to Docker)
REDIS_PASSWORD=change-me-to-a-long-random-string

# Optional tuning
# SCRAPE_DAYS_AHEAD=14
# SCRAPE_INTERVAL_SECONDS=300
# MOCK_FAIL_RATE=0.15
# MOCK_SLOW_RATE=0.05
